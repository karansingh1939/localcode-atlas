# Environment Configuration for LocalCode Atlas Backend
# Copy this to .env and adjust values

# Path to the local VectorAI DB directory
VECTORAI_DB_PATH=./.vectorai_db

# Ollama server address (default: local)
OLLAMA_HOST=http://localhost:11434

# Embedding model (nomic-embed-text gives 768-dim vectors, ~274MB)
EMBED_MODEL=nomic-embed-text

# Local model used by the optional explanation checkbox
EXPLAIN_MODEL=llama3.2

# Maximum texts per Ollama embedding request
EMBED_BATCH_SIZE=32

# Wait for repeated saves to settle before updating the index
WATCH_DEBOUNCE_SECONDS=0.35
